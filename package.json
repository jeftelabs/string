{
  "name": "@jeftelabs/string",
  "description": "A collection of helpers to perform operations on/related to a string value",
  "version": "1.7.2",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./builder": "./build/string_builder.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "quick:test": "node --import=@jeftelabs/exec --enable-source-maps bin/test.ts",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "cz"
  },
  "devDependencies": {
    "@arapucajs/eslint-config": "^1.1.2",
    "@arapucajs/prettier": "^1.1.1",
    "@arapucajs/tsconfig": "^1.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@t8ngs/assert": "^1.0.0",
    "@t8ngs/expect": "^1.1.0",
    "@t8ngs/expect-type": "^1.2.0",
    "@t8ngs/fs": "^1.0.0",
    "@t8ngs/runner": "^1.0.0",
    "@t8ngs/snapshot": "^1.0.0",
    "@lukeed/ms": "^2.0.2",
    "@jeftelabs/colors": "^1.0.0",
    "@jeftelabs/exec": "^1.0.1",
    "@types/bytes": "^3.1.5",
    "@types/node": "^25.6.0",
    "bytes": "^3.1.2",
    "c8": "^11.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "string-width": "^8.2.0",
    "truncatise": "^0.0.8",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/pluralize": "^0.0.33",
    "case-anything": "^3.1.2",
    "pluralize": "^8.0.0",
    "slugify": "^1.6.9"
  },
  "homepage": "https://github.com/jeftelabs/string#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeftelabs/string.git"
  },
  "bugs": {
    "url": "https://github.com/jeftelabs/string/issues"
  },
  "keywords": [
    "string",
    "helpers",
    "utils"
  ],
  "author": "Jefte Costa <jeftelabs@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "index.ts",
      "src/types.ts",
      "string_builder.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@arapucajs/prettier",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
